# OpenLLM Gateway environment template.
#
# Copy to /etc/openllm/openllm.env (systemd) or .env (docker compose) and set at
# least OPENLLM_ADMIN_TOKEN. Every variable here is optional except the token:
# the defaults are safe for a single instance on a trusted host.
#
# Generate a token with:  openssl rand -hex 32

# --- Identity and access ---------------------------------------------------
# Protect the admin API and the console. Without it the management API is open,
# which is only acceptable on a loopback bind. Serving a non-loopback address
# without a token is refused.
OPENLLM_ADMIN_TOKEN=change-me-to-a-long-random-value
# Exact cross-origin origins allowed to call the management API, comma
# separated (for example https://console.example.com). Empty keeps the console
# same-origin only. Wildcards are not accepted.
# OPENLLM_CORS_ORIGINS=https://console.example.com

# --- Networking ------------------------------------------------------------
# 127.0.0.1:8080 for a reverse-proxied setup; 0.0.0.0:8080 inside a container.
OPENLLM_BIND=127.0.0.1:8080
# Where openllm.db (and backups/) live. Must be writable by the service user.
OPENLLM_DATA_DIR=/var/lib/openllm
# Explicit SQLite URL; overrides OPENLLM_DATA_DIR.
# OPENLLM_DATABASE_URL=sqlite:/var/lib/openllm/openllm.db

# --- Logging ---------------------------------------------------------------
# json keeps one JSON object per line for Loki/ELK; anything else is
# human-readable. The level comes from RUST_LOG.
OPENLLM_LOG_FORMAT=json
RUST_LOG=openllm=info,tower_http=info

# --- Single-instance safety ------------------------------------------------
# refuse (default) stops a second process from serving the same database;
# warn starts anyway (unsupported: two writers on one SQLite file).
OPENLLM_MULTI_INSTANCE=refuse
# Instance lease lifetime in seconds (30-86400). A lease older than this is
# ignored, so a crashed instance never blocks the restart for longer.
OPENLLM_INSTANCE_LEASE_TTL_SECS=300

# --- Availability ----------------------------------------------------------
# Consecutive provider failures before its circuit hard-opens (0 = soft only).
OPENLLM_PROVIDER_OPEN_THRESHOLD=3
# Mirror circuits/cooldowns into SQLite so a restart does not stampede a
# provider that was still failing (0 disables it).
OPENLLM_RESILIENCE_STATE_PERSIST=1
# Grace period for in-flight requests after SIGTERM (0 waits forever).
OPENLLM_SHUTDOWN_GRACE_SECS=30

# --- Capacity guardrails ---------------------------------------------------
# Global in-flight request cap; 0 = unlimited. Shed requests get 429 + Retry-After.
OPENLLM_MAX_CONCURRENT_REQUESTS=0
# Total in-flight request-body budget in MiB; 0 = unlimited.
OPENLLM_MAX_INFLIGHT_REQUEST_MIB=0
# Milliseconds an over-capacity request may wait for a slot before a 429.
OPENLLM_ADMISSION_WAIT_MS=0
# Process memory ceiling in MiB. Leave unset to pick up the container/cgroup
# limit automatically (Linux); 0 disables the pressure guard.
# OPENLLM_MEMORY_LIMIT_MIB=
# Fraction of that ceiling at which new requests are rejected.
OPENLLM_MEMORY_SHED_RATIO=0.9

# --- Timeouts (seconds) ----------------------------------------------------
# Idle gap allowed between upstream bytes (never a total-request timeout).
OPENLLM_UPSTREAM_IDLE_TIMEOUT_SECS=300
# Total lifetime of one upstream stream; 0 disables it.
OPENLLM_STREAM_MAX_SECS=1260
# Bound on reading a client request body; 0 disables it.
OPENLLM_BODY_READ_TIMEOUT_SECS=600
# Wall-clock budget for one request's fallback loop; 0 disables it.
OPENLLM_REQUEST_TIMEOUT_SECS=600
# SSE keep-alive comment interval; 0 turns heartbeats off.
OPENLLM_SSE_KEEPALIVE_SECS=15
# Recent request activity snapshots and console events; 0 disables them.
OPENLLM_LIVE_REQUEST_TRACE=1
# Buffered request-body cap in MiB (also raise client_max_body_size in nginx).
OPENLLM_MAX_BODY_MIB=32
# Buffered non-streaming upstream response cap in MiB.
OPENLLM_MAX_UPSTREAM_BODY_MIB=64

# --- Database --------------------------------------------------------------
# Each SQLite connection keeps its own bounded page cache. Four is enough for
# the gateway's concurrent reads and keeps analytics refreshes from multiplying
# memory across a wide pool.
OPENLLM_DB_MAX_CONNECTIONS=4
OPENLLM_DB_BUSY_TIMEOUT_SECS=10
OPENLLM_DB_ACQUIRE_TIMEOUT_SECS=15
