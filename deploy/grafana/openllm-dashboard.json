{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping the OpenLLM gateway (/metrics).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["openllm", "llm-gateway"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(openllm_info, instance)", "refId": "A" },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(openllm_provider_health, provider)", "refId": "A" },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "OpenLLM Gateway",
  "uid": "openllm-gateway",
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ready",
      "description": "openllm_ready: 1 while the gateway accepts new requests, 0 while draining.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "openllm_ready{instance=~\"$instance\"}", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DRAINING" }, "1": { "text": "READY" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime",
      "description": "openllm_uptime_seconds. A reset means the process restarted.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "openllm_uptime_seconds{instance=~\"$instance\"}", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests in flight",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 8, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum(openllm_requests_in_flight{instance=~\"$instance\"})", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Memory used / limit",
      "description": "openllm_memory_used_bytes against openllm_memory_limit_bytes; 0 limit means the pressure guard is disabled.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 13, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "openllm_memory_used_bytes{instance=~\"$instance\"}", "instant": true },
        { "refId": "B", "expr": "openllm_memory_limit_bytes{instance=~\"$instance\"}", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Maintenance age",
      "description": "time() - openllm_maintenance_last_run_timestamp_seconds. The cycle runs every 60s.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - openllm_maintenance_last_run_timestamp_seconds{instance=~\"$instance\"}",
          "instant": true
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 180 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Request rate by outcome",
      "description": "openllm_requests_successful_total / openllm_requests_failed_total per second.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(openllm_requests_successful_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "successful"
        },
        {
          "refId": "B",
          "expr": "sum(rate(openllm_requests_failed_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tokens per second",
      "description": "openllm_tokens_total by type.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(openllm_tokens_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Resilience",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Circuit state per provider",
      "description": "openllm_provider_circuit_state one-hot: open=2, half_open=1, closed=0 is shown as separate series.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "openllm_provider_circuit_state{instance=~\"$instance\", provider=~\"$provider\", state=~\"open|half_open\"} == 1",
          "legendFormat": "{{provider}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "max": 1, "min": 0, "custom": { "drawStyle": "steps-after" } },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Circuit trips",
      "description": "openllm_provider_circuit_trips_total per provider.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (increase(openllm_provider_circuit_trips_total{instance=~\"$instance\", provider=~\"$provider\"}[1h]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Cooling providers, models, keys",
      "description": "openllm_provider_cooling / openllm_model_cooling / openllm_provider_key_cooling.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(openllm_provider_cooling{instance=~\"$instance\", provider=~\"$provider\"})",
          "legendFormat": "providers"
        },
        {
          "refId": "B",
          "expr": "sum(openllm_model_cooling{instance=~\"$instance\", provider=~\"$provider\"})",
          "legendFormat": "models"
        },
        {
          "refId": "C",
          "expr": "sum(openllm_provider_key_cooling{instance=~\"$instance\", provider=~\"$provider\"})",
          "legendFormat": "keys"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "steps-after" } },
        "overrides": []
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Upstream success ratio",
      "description": "Per provider: openllm_provider_successes_total / openllm_provider_requests_total.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (openllm_provider_successes_total{instance=~\"$instance\", provider=~\"$provider\"}) / clamp_min(sum by (provider) (openllm_provider_requests_total{instance=~\"$instance\", provider=~\"$provider\"}), 1)",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1, "min": 0 },
        "overrides": []
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Provider latency",
      "description": "openllm_provider_average_latency_ms per provider.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "refId": "A",
          "expr": "openllm_provider_average_latency_ms{instance=~\"$instance\", provider=~\"$provider\"}",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Quota pool saturation and denials",
      "description": "openllm_pool_saturated and the denial rate per pool.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "targets": [
        {
          "refId": "A",
          "expr": "openllm_pool_saturated{instance=~\"$instance\"}",
          "legendFormat": "{{pool}} saturated"
        },
        {
          "refId": "B",
          "expr": "sum by (pool) (rate(openllm_pool_denials_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{pool}} denials/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Pool window usage vs limit",
      "description": "openllm_pool_requests_window against openllm_pool_request_limit per pool.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "targets": [
        {
          "refId": "A",
          "expr": "openllm_pool_requests_window{instance=~\"$instance\"}",
          "legendFormat": "{{pool}} used"
        },
        {
          "refId": "B",
          "expr": "openllm_pool_request_limit{instance=~\"$instance\"} > 0",
          "legendFormat": "{{pool}} limit"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Capacity, database and runtime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Admission and shedding",
      "description": "openllm_request_capacity_available / openllm_request_capacity_limit and shed counters.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "targets": [
        {
          "refId": "A",
          "expr": "openllm_request_capacity_available{instance=~\"$instance\"}",
          "legendFormat": "slots free"
        },
        {
          "refId": "B",
          "expr": "openllm_request_capacity_limit{instance=~\"$instance\"}",
          "legendFormat": "slots cap"
        },
        {
          "refId": "C",
          "expr": "rate(openllm_requests_shed_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "shed/s"
        },
        {
          "refId": "D",
          "expr": "rate(openllm_memory_shed_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "memory shed/s"
        },
        {
          "refId": "E",
          "expr": "rate(openllm_request_bytes_shed_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "bytes shed/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Memory pressure",
      "description": "openllm_memory_used_bytes vs openllm_memory_threshold_bytes and the shedding flag.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "targets": [
        {
          "refId": "A",
          "expr": "openllm_memory_used_bytes{instance=~\"$instance\"}",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "openllm_memory_threshold_bytes{instance=~\"$instance\"} > 0",
          "legendFormat": "shed threshold"
        },
        {
          "refId": "C",
          "expr": "openllm_memory_limit_bytes{instance=~\"$instance\"} > 0",
          "legendFormat": "limit"
        },
        {
          "refId": "D",
          "expr": "openllm_memory_pressure{instance=~\"$instance\"}",
          "legendFormat": "shedding"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "Database size and pool",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "targets": [
        {
          "refId": "A",
          "expr": "openllm_database_size_bytes{instance=~\"$instance\"}",
          "legendFormat": "size"
        },
        {
          "refId": "B",
          "expr": "openllm_database_free_bytes{instance=~\"$instance\"}",
          "legendFormat": "free"
        },
        {
          "refId": "C",
          "expr": "openllm_db_pool_connections{instance=~\"$instance\"}",
          "legendFormat": "pool connections"
        },
        {
          "refId": "D",
          "expr": "openllm_db_pool_idle{instance=~\"$instance\"}",
          "legendFormat": "pool idle"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 44,
      "type": "timeseries",
      "title": "Runtime lag",
      "description": "openllm_runtime_lag_millis; a sustained rise means the async runtime is blocked.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 48 },
      "targets": [
        {
          "refId": "A",
          "expr": "openllm_runtime_lag_millis{instance=~\"$instance\"}",
          "legendFormat": "lag"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 45,
      "type": "timeseries",
      "title": "Average request latency and cost",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 48 },
      "targets": [
        {
          "refId": "A",
          "expr": "openllm_average_latency_ms{instance=~\"$instance\"}",
          "legendFormat": "avg latency"
        },
        {
          "refId": "B",
          "expr": "rate(openllm_estimated_cost_usd_total{instance=~\"$instance\"}[1h]) * 3600",
          "legendFormat": "est. USD/h"
        },
        {
          "refId": "C",
          "expr": "rate(openllm_unpriced_requests_total{instance=~\"$instance\"}[1h])",
          "legendFormat": "unpriced/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg latency" },
            "properties": [{ "id": "unit", "value": "ms" }]
          }
        ]
      }
    },
    {
      "id": 46,
      "type": "timeseries",
      "title": "Configured inventory",
      "description": "Providers, models, routes and api keys by state.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 48 },
      "targets": [
        { "refId": "A", "expr": "sum(openllm_providers{instance=~\"$instance\"})", "legendFormat": "providers" },
        { "refId": "B", "expr": "sum(openllm_models{instance=~\"$instance\"})", "legendFormat": "models" },
        { "refId": "C", "expr": "sum(openllm_routes{instance=~\"$instance\"})", "legendFormat": "routes" },
        { "refId": "D", "expr": "sum(openllm_api_keys{instance=~\"$instance\"})", "legendFormat": "api keys" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
